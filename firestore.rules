rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/data/{documentId} {
      allow read, write: if request.auth != null && request.auth.uid == userId
        && documentId == 'main' && request.resource.data.keys().hasOnly(['payload','updatedAt'])
        && request.resource.data.payload is map;
      allow read: if request.auth != null && request.auth.uid == userId && documentId == 'main';
    }
  }
}
